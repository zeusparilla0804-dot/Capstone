NODE_ENV=production
PORT=3000
FRONTEND_URL=https://staging.example.com
DB_SERVER=staging-sql.example.internal
DB_PORT=1433
DB_DATABASE=la_chef_staging
DB_USER=la_chef_staging_app
DB_PASSWORD=replace_in_secret_store
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
PAYMENT_PROOF_UPLOAD_ROOT=/var/lib/la-chef/uploads
PASSWORD_RESET_HMAC_SECRET=replace_with_at_least_32_random_bytes_from_secret_store
ADMIN_MFA_ENCRYPTION_KEY=replace_with_base64_of_32_random_bytes_from_secret_store

# Optional SMTP placeholders. Supply all SMTP values through the staging secret store.
# SMTP_HOST=smtp.staging.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace_in_secret_store
# SMTP_PASSWORD=replace_in_secret_store
# SMTP_FROM_ADDRESS=no-reply@staging.example.com
# SMTP_FROM_NAME=LA Chef Event Catering Services
EMAIL_WORKER_ENABLED=false
# Optional separate 32+ byte secret; otherwise PASSWORD_RESET_HMAC_SECRET is used with purpose separation.
# EMAIL_VERIFICATION_HMAC_SECRET=
# EMAIL_WORKER_POLL_INTERVAL_MS=30000
# EMAIL_WORKER_BATCH_SIZE=10
# EMAIL_WORKER_MAX_ATTEMPTS=5
# EMAIL_WORKER_RETRY_BASE_MS=60000
# EMAIL_WORKER_RETRY_CAP_MS=3600000
# EMAIL_WORKER_LEASE_MS=300000
