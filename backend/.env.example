PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
DB_SERVER=your_sql_server_host
DB_PORT=1433
DB_DATABASE=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# Production should normally use true/false respectively.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
PAYMENT_PROOF_UPLOAD_ROOT=./var/uploads

# Required in production. Use at least 32 random bytes from a secret manager.
# Rotating this value invalidates all pending password reset links.
# PASSWORD_RESET_HMAC_SECRET=replace_with_at_least_32_random_bytes
# ADMIN_MFA_ENCRYPTION_KEY=base64_of_32_random_bytes

# Fresh database verification only. Use a dedicated non-runtime SQL provisioner.
# VERIFY_DB_SERVER=your_sql_server_host
# VERIFY_DB_PORT=1433
# VERIFY_DB_ADMIN_DATABASE=master
# VERIFY_DB_USER=your_verification_provisioner_user
# VERIFY_DB_PASSWORD=replace_in_secret_store
# VERIFY_DB_ENCRYPT=true
# VERIFY_DB_TRUST_SERVER_CERTIFICATE=false
VERIFY_DB_CONFIRM_DISPOSABLE=false

# Optional transactional email. Leave every SMTP line commented to keep delivery disabled;
# notifications will remain pending and visible to administrators.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace_with_smtp_user
# SMTP_PASSWORD=replace_in_secret_store
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_FROM_NAME=LA Chef Event Catering Services
# EMAIL_WORKER_ENABLED=true
# EMAIL_WORKER_POLL_INTERVAL_MS=5000
# EMAIL_WORKER_BATCH_SIZE=10
# EMAIL_WORKER_MAX_ATTEMPTS=5
# EMAIL_WORKER_RETRY_BASE_MS=60000
# EMAIL_WORKER_RETRY_CAP_MS=3600000
# EMAIL_WORKER_LEASE_MS=300000

# Alternative HTTPS delivery for hosts that block SMTP, including Render Free.
# Select this only after adding all three required Resend values in the host secret store.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=replace_in_secret_store
# RESEND_FROM_ADDRESS=no-reply@your-verified-domain.example
# RESEND_FROM_NAME=LA Chef Event Catering Services

# Required only when running: npm run admin:create
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_PASSWORD=


# Optional dedicated 32+ byte secret; falls back to PASSWORD_RESET_HMAC_SECRET with separate HMAC purposes.
# New customer registration requires a configured secret, an email transport, and enabled email worker.
# EMAIL_VERIFICATION_HMAC_SECRET=
